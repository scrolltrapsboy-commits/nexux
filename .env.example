# Copy to .env (or set these in your host's dashboard). Nothing here is ever sent to the browser.
PORT=3000
# SQLite file (default) or in-memory for experiments. Postgres is not implemented yet (see README).
DATABASE_URL=sqlite:./data/nexus.db
# Long random string. REQUIRED in production, otherwise sessions are lost on every restart.
SESSION_SECRET=change-me-to-a-long-random-string
# Only needed when the web client is hosted on a different origin than this server.
CLIENT_URL=
# Redirect http -> https behind a proxy that sets x-forwarded-proto (set to 1 in production).
FORCE_HTTPS=0
# Optional TURN relay for people behind strict NATs. STUN is always on.
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_PASSWORD=
# One-time import of the old data.json (accounts, friends, DMs). Ignored when the file does not exist.
LEGACY_JSON=./data.json
